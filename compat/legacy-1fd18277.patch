new file mode 100644
index 0000000000..4517c25fc6
--- /dev/null
+++ b/gateway/turn_scheduling.py
@@ -0,0 +1,122 @@
+"""Optional whole-chat-turn seam for the verified legacy 1fd18277 layout.
+
+Keep native session claims, profile scope, controls and delivery unchanged.
+No prompt reinjection and no monkeypatching. This is not a durable admission API.
+"""
+import asyncio
+from contextvars import ContextVar
+from types import MappingProxyType
+
+COMPATIBILITY = 'legacy-1fd18277'
+KIND = 'gateway_turn_execution'
+_physical_events: ContextVar[list | None] = ContextVar('teams_legacy_physical_events', default=None)
+_legacy_scope: ContextVar[dict | None] = ContextVar('teams_legacy_scope', default=None)
+_physical_join_tasks = set()
+
+
+def register_physical_completion(event):
+    events = _physical_events.get()
+    if events is not None:
+        events.append(event)
+
+
+def _settle_physical(future, events):
+    if all(event.is_set() for event in events):
+        if not future.done():
+            future.set_result(None)
+        return
+    async def wait():
+        while not all(event.is_set() for event in events):
+            await asyncio.sleep(.05)
+        if not future.done():
+            future.set_result(None)
+    task = asyncio.create_task(wait())
+    _physical_join_tasks.add(task)
+    task.add_done_callback(_physical_join_tasks.discard)
+
+
+async def _join(task):
+    cancelled = False
+    while True:
+        try:
+            result = await asyncio.shield(task)
+            break
+        except asyncio.CancelledError:
+            if task.done() and task.cancelled():
+                raise
+            cancelled = True
+    if cancelled:
+        raise asyncio.CancelledError
+    return result
+
+
+async def run_scheduled_turn(next_call, **metadata):
+    from hermes_cli.plugins import _delivery_manager
+    callbacks = list(_delivery_manager()._middleware.get(KIND, ()))
+    if not callbacks:
+        return await next_call()
+    completion = asyncio.get_running_loop().create_future()
+    events = []
+    native_started = False
+    metadata = MappingProxyType({**metadata, 'physical_completion': completion})
+
+    async def native():
+        nonlocal native_started
+        native_started = True
+        token = _physical_events.set(events)
+        try:
+            return await next_call()
+        finally:
+            _physical_events.reset(token)
+            _settle_physical(completion, events)
+
+    async def at(index):
+        if index == len(callbacks):
+            return await native()
+        closed, task = False, None
+        async def once():
+            nonlocal task
+            if closed or task is not None:
+                raise RuntimeError('gateway turn continuation is single-use and turn-scoped')
+            task = asyncio.create_task(at(index + 1))
+            return await _join(task)
+        error = None
+        try:
+            await callbacks[index](next_call=once, **metadata)
+        except BaseException as exc:
+            error = exc
+        finally:
+            closed = True
+        if task is not None:
+            result = await _join(task)
+            if error is not None and not isinstance(error, Exception):
+                raise error
+            return result
+        if error is not None:
+            raise error
+        raise RuntimeError('gateway scheduling middleware did not execute its continuation')
+    try:
+        return await at(0)
+    finally:
+        if not native_started:
+            _settle_physical(completion, events)
+
+
+async def run_legacy_turn(next_call, *, message, session_id):
+    from hermes_constants import get_hermes_home
+    profile_id = str(get_hermes_home())
+    parent = _legacy_scope.get()
+    if parent and parent['open'] and parent['profile_id'] == profile_id:
+        # Native queued follow-ups recursively call _run_agent before the outer
+        # call returns. They remain inside that same lease, not a second seat.
+        return await next_call()
+    scope = {'profile_id': profile_id, 'open': True}
+    async def native():
+        token = _legacy_scope.set(scope)
+        try:
+            return await next_call()
+        finally:
+            scope['open'] = False
+            _legacy_scope.reset(token)
+    return await run_scheduled_turn(native, profile_id=profile_id, session_id=session_id,
+                                    admission_id='', input_bytes=len(message.encode('utf-8')))
