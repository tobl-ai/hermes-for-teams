+"""Async whole-turn scheduling contract: never consume/reinject user events."""
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.turn_scheduling import run_scheduled_turn
+
+
+def test_safe_worker_never_discovers_or_executes_plugins(monkeypatch):
+    async def case():
+        from hermes_cli import plugins
+        import agent.safe_worker_policy as policy
+        monkeypatch.setattr(policy, 'safe_worker_enabled', lambda: True)
+        def forbidden():
+            raise AssertionError('safe worker must not discover plugins')
+        monkeypatch.setattr(plugins, '_delivery_manager', forbidden)
+        async def native():
+            return 'isolated-native'
+        assert await run_scheduled_turn(native) == 'isolated-native'
+    asyncio.run(case())
+
+
+def test_disabled_and_fail_closed(monkeypatch):
+    async def case():
+        from hermes_cli import plugins
+        manager = SimpleNamespace(_middleware={})
+        monkeypatch.setattr(plugins, '_delivery_manager', lambda: manager)
+        calls = []
+        async def native():
+            calls.append(1)
+            return 'original'
+        assert await run_scheduled_turn(native, input_bytes=1) == 'original'
+        async def broken(**kwargs):
+            raise TimeoutError('admission policy failed')
+        manager._middleware['gateway_turn_execution'] = [broken]
+        with pytest.raises(TimeoutError):
+            await run_scheduled_turn(native, input_bytes=1)
+        assert calls == [1]  # no fail-open execution or replay
+    asyncio.run(case())
+
+
+def test_once_only_and_ack_loss(monkeypatch):
+    async def case():
+        from hermes_cli import plugins
+        manager = SimpleNamespace(_middleware={})
+        monkeypatch.setattr(plugins, '_delivery_manager', lambda: manager)
+        calls = []
+        saved = []
+        async def native():
+            calls.append(1)
+            return 'original'
+        async def policy(next_call, **kwargs):
+            saved.append(next_call)
+            assert await next_call() == 'original'
+            with pytest.raises(RuntimeError):
+                await next_call()
+            raise TimeoutError('ack lost after execution')
+        manager._middleware['gateway_turn_execution'] = [policy]
+        assert await run_scheduled_turn(native, input_bytes=1) == 'original'
+        assert calls == [1]
+        with pytest.raises(RuntimeError):
+            await saved[0]()
+        assert calls == [1]
+    asyncio.run(case())
+
+
+def test_cannot_short_circuit_or_spawn_unawaited_turn(monkeypatch):
+    async def case():
+        from hermes_cli import plugins
+        calls = []
+        async def native():
+            calls.append(1)
+        async def policy(**kwargs):
+            return 'fabricated success'
+        monkeypatch.setattr(plugins, '_delivery_manager', lambda: SimpleNamespace(_middleware={'gateway_turn_execution': [policy]}))
+        with pytest.raises(RuntimeError):
+            await run_scheduled_turn(native, input_bytes=1)
+        assert not calls
+    asyncio.run(case())
+
+
+def test_cancellation_joins_native_work_and_does_not_retry(monkeypatch):
+    async def case():
+        from hermes_cli import plugins
+        gate, started = asyncio.Event(), asyncio.Event()
+        calls = []
+        async def native():
+            calls.append(1)
+            started.set()
+            await gate.wait()
+            return 'original'
+        async def policy(next_call, **kwargs):
+            return await next_call()
+        monkeypatch.setattr(plugins, '_delivery_manager', lambda: SimpleNamespace(_middleware={'gateway_turn_execution': [policy]}))
+        turn = asyncio.create_task(run_scheduled_turn(native, input_bytes=1))
+        await started.wait()
+        turn.cancel()
+        await asyncio.sleep(0)
+        turn.cancel()
+        await asyncio.sleep(0)
+        assert not turn.done()
+        gate.set()
+        with pytest.raises(asyncio.CancelledError):
+            await turn
+        assert calls == [1]
+    asyncio.run(case())
+
+
+def test_native_exception_cannot_be_swallowed_by_policy(monkeypatch):
+    async def case():
+        from hermes_cli import plugins
+        calls = []
+        async def native():
+            calls.append(1)
+            raise LookupError('native failure')
+        async def policy(next_call, **kwargs):
+            try:
+                await next_call()
+            except LookupError:
+                return 'invented success'
+        monkeypatch.setattr(plugins, '_delivery_manager', lambda: SimpleNamespace(_middleware={'gateway_turn_execution': [policy]}))
+        with pytest.raises(LookupError):
+            await run_scheduled_turn(native, input_bytes=1)
+        assert calls == [1]
+    asyncio.run(case())
+
+
+def test_routed_profile_manager_and_metadata_are_preserved(tmp_path, monkeypatch):
+    async def case():
+        from gateway import session_ingress
+        from gateway.run import _profile_runtime_scope
+        from gateway.session_contract import SessionRef
+        from gateway.session_finite import execute_finite_admission
+        from hermes_cli.plugins import get_plugin_manager
+        from hermes_constants import get_hermes_home
+        launch, routed = tmp_path / 'launch', tmp_path / 'profiles' / 'routed'
+        launch.mkdir()
+        routed.mkdir(parents=True)
+        seen = []
+        async def policy(next_call, **metadata):
+            seen.append(('policy', get_hermes_home(), metadata))
+            return await next_call()
+        with _profile_runtime_scope(launch):
+            get_plugin_manager()._discovered = True
+        with _profile_runtime_scope(routed):
+            manager = get_plugin_manager()
+            manager._discovered = True
+            monkeypatch.setattr(manager, '_middleware', {'gateway_turn_execution': [policy]})
+        row = {'admission_id': 'a', 'payload': {'text': '가', 'finite': False}}
+        async def native(authority, ref, passed_row):
+            assert passed_row is row  # original complete envelope, not an addon copy
+            seen.append(('native', get_hermes_home()))
+            return 'actual-result'
+        monkeypatch.setattr(session_ingress, 'execute_admission', native)
+        authority = SimpleNamespace(profile_id=str(routed), runner=SimpleNamespace(config=SimpleNamespace(multiplex_profiles=True)))
+        with _profile_runtime_scope(launch):
+            assert await execute_finite_admission(authority, SessionRef(str(routed), 's'), row) == 'actual-result'
+            assert get_hermes_home() == launch
+        physical = seen[0][2].pop('physical_completion')
+        assert physical.done() and not physical.cancelled()
+        assert seen[0] == ('policy', routed, {'profile_id': str(routed), 'session_id': 's', 'admission_id': 'a', 'input_bytes': 3})
+        assert seen[1] == ('native', routed)
+    asyncio.run(case())
