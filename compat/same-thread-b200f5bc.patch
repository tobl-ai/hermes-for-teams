index 00000000..da5814ec
--- /dev/null
+++ b/tools/native_remote_kernel.py
@@ -0,0 +1,52 @@
+"""Direct backend kernel entrypoint: no outer shell startup can escape its tree."""
+import json
+import secrets
+import shlex
+import threading
+import time
+
+_BOOT = r'''
+import ctypes,json,os,runpy,sys
+from pathlib import Path
+request=json.load(sys.stdin)
+os.umask(0o077)
+if sys.platform!='linux' or ctypes.CDLL(None,use_errno=True).prctl(36,1,0,0,0)!=0:
+    raise RuntimeError('Native remote kernel requires Linux subreaper')
+os.environ.update(request['env'])
+kdir=Path(request['kdir'])
+with open(kdir/'runner.log','a') as log:
+    os.dup2(log.fileno(),1); os.dup2(log.fileno(),2)
+start=Path('/proc/self/stat').read_text().rsplit(')',1)[1].split()[19]
+ready=kdir/'native-ready.json'
+ready.with_suffix('.tmp').write_text(json.dumps({'pid':os.getpid(),'start':start,'nonce':request['nonce']}))
+os.replace(ready.with_suffix('.tmp'),ready)
+sys.path.insert(0,str(kdir))
+runpy.run_path(str(kdir/'kernel_runner.py'),run_name='__main__')
+'''
+
+
+def spawn(env, env_type, owner, kernel_dir, rpc_token):
+    from tools.code_kernel_remote import RemoteKernel
+    from tools.environments.remote_supervision import native_control
+    from hermes_time import get_timezone_name
+    nonce=secrets.token_hex(32)
+    request={'kdir':kernel_dir,'nonce':nonce,'env':{
+        'HERMES_KERNEL_DIR':kernel_dir,'HERMES_RPC_DIR':kernel_dir+'/rpc',
+        'HERMES_RPC_TOKEN':rpc_token,'PYTHONDONTWRITEBYTECODE':'1','TZ':get_timezone_name()}}
+    # Secret RPC material is on the private stdin pipe, not world-readable argv.
+    proc=env._run_native_argv(['python3','-I','-c',_BOOT],stdin_data=json.dumps(request),timeout=20)
+    deadline=time.monotonic()+10
+    while time.monotonic()<deadline:
