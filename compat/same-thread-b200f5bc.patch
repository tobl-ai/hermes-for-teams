new file mode 100644
index 00000000..b25ff8de
--- /dev/null
+++ b/gateway/task_egress.py
@@ -0,0 +1,183 @@
+"""Task-bound view of the real native adapter; never a new transport owner.
+
+All task text (stream/draft/commentary/progress/edit/final/recovery) uses one
+ledger-validated label and original request anchor. Non-task adapters are returned
+unchanged. Capability probes keep the actual adapter's class inheritance.
+"""
+from dataclasses import dataclass, replace
+from functools import wraps
+import inspect
+from pathlib import Path
+import sqlite3
+
+
+@dataclass(frozen=True)
+class TaskRoute:
+    ledger: Path
+    branch: str
+    room: str
+    sender: str
+    chat: str
+    prefix: str
+    anchor: str
+
+    def validate(self):
+        with sqlite3.connect(f'file:{self.ledger}?mode=ro', uri=True) as db:
+            row = db.execute('SELECT room,sender,label,message FROM tasks WHERE id=?', (self.branch,)).fetchone()
+        if (row is None or row[0] != self.room or row[1] != self.sender
+                or row[3] != self.anchor or self.prefix != f'[{row[2]} · {self.branch[:8]} · 요청 {row[3]}]\n'):
+            raise RuntimeError('Task egress lost its authoritative binding')
+
+    def text(self, text):
+        return text if text.startswith(self.prefix) else self.prefix + text
+
+
+def task_route(runner, source):
+    branch = getattr(source, 'task_branch', None)
+    if not branch:
+        return None
+    from gateway.session_authorities import active_authority
+    from gateway.session_identity import replace_source
+    authority = active_authority(runner)
+    if authority is None:
+        raise RuntimeError('Task egress requires native authority')
+    ledger = Path(authority.db.db_path).parent / 'native-tasks.sqlite3'
+    from gateway.session_identity import identity_of
+    identity = identity_of(source)
+    if identity is None and getattr(source,'profile',None):
+        from hermes_cli.profiles import profile_exists
+        active = getattr(runner,'_active_profile_name',None)
+        active = active() if callable(active) else None
+        primary = getattr(runner,'_primary_profile_name',None)
+        if source.profile not in {active,primary} and not profile_exists(source.profile):
+            raise RuntimeError('Task egress explicit runtime profile does not exist')
+    if (identity is not None and getattr(source,'profile',None)
+            and source.profile != identity.runtime_profile):
+        raise RuntimeError('Task egress profile stamp differs from native identity')
+    try:
+        owner_home = runner._resolve_profile_home_for_source(source).resolve()
+    except Exception as exc:
+        raise RuntimeError('Task egress runtime profile is unresolved') from exc
+    if owner_home != ledger.parent.resolve():
+        raise RuntimeError('Task egress source belongs to another native profile home')
+    room = runner._session_key_for_source(replace_source(source, task_branch=None))
+    with sqlite3.connect(f'file:{ledger}?mode=ro', uri=True) as db:
+        row = db.execute('SELECT room,sender,label,message FROM tasks WHERE id=?', (branch,)).fetchone()
+    if row is None or row[0] != room or row[1] != source.user_id:
+        raise RuntimeError('Task egress source does not own this room/profile/task')
+    route = TaskRoute(ledger, branch, room, source.user_id, source.chat_id,
+                      f'[{row[2]} · {branch[:8]} · 요청 {row[3]}]\n', row[3])
+    route.validate()
+    return route
+
+
+_TEXT_METHODS = {'send': 'content', 'edit_message': 'content', 'send_draft': 'content',
+                 'send_stream_frame': 'content', 'send_native_task_card_progress': 'fallback_text',
+                 'send_clarify': 'question', 'send_exec_approval': 'description',
+                 'send_slash_confirm': 'title', '_send_exec_approval_prompt': None}
+_PROXY_CLASSES = {}
+
+
+def _bound_method(proxy, name):
+    target = object.__getattribute__(proxy, '_task_target')
+    route = object.__getattribute__(proxy, '_task_route')
+    original = getattr(target, name)
+    if inspect.ismethod(original) and original.__self__ is target:
+        original = original.__func__.__get__(proxy, type(proxy))
+    signature = inspect.signature(original)
+    @wraps(original)
+    async def call(*args, **kwargs):
+        route.validate()  # exact durable target, before transport I/O
+        bound = signature.bind_partial(*args, **kwargs)
+        values = bound.arguments
+        extra_key = next((key for key, param in signature.parameters.items()
+                          if param.kind == inspect.Parameter.VAR_KEYWORD), None)
+        extras = values.setdefault(extra_key, {}) if extra_key is not None else {}
+        def get(key, default=None):
+            return values.get(key, extras.get(key, default))
+        def put(key, value):
+            if key in signature.parameters:
+                values[key] = value
+            else:
+                extras[key] = value
+        if str(get('chat_id', route.chat)) != str(route.chat):
+            raise RuntimeError('Task egress cannot change destination')
+        field = _TEXT_METHODS[name]
+        from gateway.platforms.base import BasePlatformAdapter
+        if name in {'send_clarify', 'send_exec_approval'} and getattr(original, '__func__', None) is getattr(BasePlatformAdapter, name):
+            field = None  # the real send/hook below owns rendering, not callback arguments
+        if name == '_send_exec_approval_prompt':
+            prompt = values['prompt']
+            if str(prompt.chat_id) != str(route.chat):
+                raise RuntimeError('Task interaction cannot change destination')
+            values['prompt'] = replace(prompt, text=route.text(prompt.text),
+                metadata=dict(prompt.metadata or {}, reply_to_message_id=route.anchor,
+                              telegram_reply_to_message_id=route.anchor))
+        # Stream adapters call the first argument either content or text.
+        if name == 'send_stream_frame' and 'text' in signature.parameters:
+            field = 'text'
+        text = get(field) if field else None
+        if isinstance(text, str):
+            put(field, route.text(text))
+        if name in {'send', 'send_stream_frame', 'send_native_task_card_progress'}:
+            put('reply_to', route.anchor)
+        metadata = get('metadata')
+        if name in {'send_clarify', 'send_exec_approval', 'send_slash_confirm'}:
+            metadata = dict(metadata or {}, reply_to_message_id=route.anchor,
+                            telegram_reply_to_message_id=route.anchor)
+        if isinstance(metadata, dict):
+            metadata = dict(metadata)
+            for key in ('reply_to_message_id', 'telegram_reply_to_message_id'):
+                if key in metadata:
+                    metadata[key] = route.anchor
+            put('metadata', metadata)
+        if name == 'edit_message':
+            message = str(get('message_id', ''))
+            with sqlite3.connect(f'file:{route.ledger}?mode=ro', uri=True) as db:
+                owned = db.execute('SELECT 1 FROM reply_bindings WHERE room=? AND task=? AND message=?',
+                                   (route.room, route.branch, message)).fetchone()
+            if owned is None:
+                raise RuntimeError('Task egress cannot edit an unowned message')
+        result = await original(*bound.args, **bound.kwargs)
+        if getattr(result, 'success', False) is True and isinstance(getattr(result, 'message_id', None), str) and result.message_id:
+            with sqlite3.connect(route.ledger) as db:
+                db.execute('INSERT OR IGNORE INTO reply_bindings VALUES (?,?,?)',
+                           (route.room, result.message_id, route.branch))
+        return result
+    return call
+
+
+def _proxy_getattribute(proxy, name):
+    if name in {'_task_target', '_task_route'}:
+        return object.__getattribute__(proxy, name)
+    if name in _TEXT_METHODS:
+        return _bound_method(proxy, name)
+    target = object.__getattribute__(proxy, '_task_target')
+    value = getattr(target, name)
+    # Renderers must keep this task view as self, so nested send/card calls do
+    # not silently jump back to the unbound transport object.
+    if inspect.ismethod(value) and value.__self__ is target:
+        return value.__func__.__get__(proxy, type(proxy))
+    return value
+
+
+def _proxy_setattr(proxy, name, value):
+    setattr(object.__getattribute__(proxy, '_task_target'), name, value)
+
+
+def task_adapter(runner, source, adapter):
+    if not getattr(source, 'task_branch', None):
+        return adapter
+    route = task_route(runner, source)
+    if adapter is None:
+        raise RuntimeError('Task egress has no owning transport adapter')
+    cls = type(adapter)
+    proxy_cls = _PROXY_CLASSES.get(cls)
+    if proxy_cls is None:
+        proxy_cls = _PROXY_CLASSES[cls] = type('TaskBound' + cls.__name__, (cls,),
+                                             {'__getattribute__': _proxy_getattribute,
+                                              '__setattr__': _proxy_setattr})
+    proxy = object.__new__(proxy_cls)
+    object.__setattr__(proxy, '_task_target', adapter)
+    object.__setattr__(proxy, '_task_route', route)
+    return proxy
diff --git a/gateway/task_resources.py b/gateway/task_resources.py
new file mode 100644
index 00000000..919f9bc3
--- /dev/null
+++ b/gateway/task_resources.py
@@ -0,0 +1,158 @@
+"""Durable physical tool reservations for the optional native task seam.
+
+Never expire an uncertain holder after coroutine cancellation or owner death.
+Unknown write sets conflict globally. Only local file tools have bounded physical
+completion here; arbitrary shell/API/delegated side effects remain uncertain.
+"""
+from contextvars import ContextVar
+import json
+import os
+from pathlib import Path
+import sqlite3
+import threading
+import uuid
+
+_held = ContextVar('task_resource_lease', default=None)
+_SAFE_READS = frozenset({'read_file', 'search_files', 'web_search', 'web_extract', 'vision_analyze', 'skill_view'})
+
+
+class ResourceBusy(RuntimeError):
+    pass
+
+
+class ResourceGuard:
+    def __init__(self, path):
+        self.path = Path(path)
+        with self.connect() as db:
+            db.execute('PRAGMA journal_mode=WAL')
+            db.execute('CREATE TABLE IF NOT EXISTS reservations (id TEXT PRIMARY KEY, resources TEXT NOT NULL, state TEXT NOT NULL)')
+
+    def connect(self):
+        return sqlite3.connect(self.path, timeout=30)
+
+    def held_count(self):
+        with self.connect() as db:
+            return db.execute('SELECT COUNT(*) FROM reservations').fetchone()[0]
+
+    @staticmethod
+    def resources(tool, args):
+        if tool not in {'write_file', 'patch'} or not isinstance(args.get('path'), str):
+            return ('*',)
+        path = Path(args['path']).expanduser().resolve()
+        keys = ['path:' + os.path.normcase(str(path))]
+        try:
+            stat = path.stat()
+        except FileNotFoundError:
+            pass
+        else:
+            keys.append(f'inode:{stat.st_dev}:{stat.st_ino}')
+        return tuple(sorted(keys))
+
+    def acquire(self, resources):
+        with self.connect() as db:
+            db.execute('BEGIN IMMEDIATE')
+            for (encoded,) in db.execute('SELECT resources FROM reservations'):
+                other = json.loads(encoded)
+                if '*' in resources or '*' in other or set(resources).intersection(other):
+                    return None
+            reservation = uuid.uuid4().hex
+            db.execute('INSERT INTO reservations VALUES (?,?,?)', (reservation, json.dumps(resources), 'active'))
+            return reservation
+
+    def run(self, tool, args, next_call, *, wait=True):
+        if tool in _SAFE_READS:
+            return next_call(args)
+        resources = self.resources(tool, args)
+        previous = _held.get()
+        if previous is not None:
+            if previous[0] != self.path or '*' not in previous[1]:
+                raise ResourceBusy('Nested write set cannot expand a file reservation')
+            return next_call(args)
+        while True:
+            reservation = self.acquire(resources)
+            if reservation is not None:
+                # Re-check aliases after reservation acquisition. Unknown tools (which
+                # include symlink/hardlink creation) hold the global conflicting key.
+                if resources == self.resources(tool, args):
+                    break
+                self.release(reservation)
+                resources = self.resources(tool, args)
+            if not wait:
+                raise ResourceBusy('Physical or unknown write reservation is still held')
+            threading.Event().wait(.025)
+        token = _held.set((self.path, resources))
+        known = resources != ('*',)
+        try:
+            return next_call(args)
+        finally:
+            _held.reset(token)
+            if known:
+                self.release(reservation)  # synchronous callback has physically returned
+            else:
+                # The generic tool API cannot prove detached subprocesses or remote
+                # side effects have quiesced, including errors/timeouts. Fail closed.
+                with self.connect() as db:
+                    db.execute('UPDATE reservations SET state=? WHERE id=?', ('unknown', reservation))
+
+    def release(self, reservation):
+        with self.connect() as db:
+            db.execute('DELETE FROM reservations WHERE id=?', (reservation,))
+
+
+def shared_guard_path():
+    from gateway.status import _get_lock_dir
+    return _get_lock_dir() / 'native-task-resources.sqlite3'
+
+
+def dispatch_reserved(tool, args, ids, next_call):
+    from hermes_constants import get_hermes_home
+    from tools.file_resource_contract import prepare, _current
+    home = Path(get_hermes_home())
+    path = shared_guard_path()
+    if tool in _SAFE_READS or (not path.exists() and not (home / 'native-tasks.sqlite3').exists()):
+        return next_call(args)
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    guard = ResourceGuard(path)
+    if tool == 'process_manage':
+        from tools.process_resource_contract import may_control_leased_process
+        if may_control_leased_process(args, ids.task_id, guard):
+            return next_call(args)
+    from tools.kernel_resource_contract import _current_kernel, owned_dispatch
+    kernel_owner = _current_kernel.get()
+    if kernel_owner is not None:
+        return owned_dispatch(kernel_owner, guard, tool, args, ids.task_id, next_call)
+    if tool == 'terminal':
+        from tools.process_resource_contract import reserved_terminal
+        return reserved_terminal(guard, args, next_call)
+    if tool == 'execute_code':
+        from tools.kernel_resource_contract import reserved_kernel
+        return reserved_kernel(guard, args, next_call)
+    if _current.get() is not None or _held.get() is not None:
+        raise ResourceBusy('Nested native write reservation cannot expand its execution plan')
+    witness = prepare(tool, args, ids.task_id)
+    if witness is None:
+        if tool in {'write_file', 'patch'}:
+            # Non-native file backends execute their real shell operations under
+            # one global lease; each must produce its own backend-owned receipt.
+            from tools.process_resource_contract import reserved_terminal
+            return reserved_terminal(guard, args, next_call)
+        return guard.run('uncertified_native_execution', args, next_call, wait=False)
+    reservation = guard.acquire(witness.resources)
+    if reservation is None:
+        raise ResourceBusy('Physical or unknown write reservation is still held')
+    # Re-resolve under the reservation, before the handler can do any I/O.
+    refreshed = prepare(tool, args, ids.task_id)
+    if refreshed is None or refreshed.resources != witness.resources:
+        guard.release(reservation)
+        raise ResourceBusy('Backend resource identity changed before execution')
+    token = _current.set(witness)
+    try:
+        return next_call(args)
+    finally:
+        _current.reset(token)
+        if witness.complete:
+            guard.release(reservation)
+        else:
+            with guard.connect() as db:
+                db.execute('UPDATE reservations SET state=?, resources=? WHERE id=?',
+                           ('unknown', json.dumps(('*',)), reservation))
