diff --git a/gateway/question_authority.py b/gateway/question_authority.py
new file mode 100644
index 00000000..b42f9658
--- /dev/null
+++ b/gateway/question_authority.py
@@ -0,0 +1,120 @@
+"""Native question capability: snapshot-only answers, zero effectful tool budget.
+
+Classification is only a hint. The original owner-written task decision fixes the
+capability for the entire branch (including later follow-ups). No prompt, tool
+argument, request metadata or model-supplied session ID can upgrade it. This is a
+trusted in-process boundary, not a sandbox against malicious Python/plugins.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from pathlib import Path
+import sqlite3
+import threading
+import time
+from dataclasses import dataclass, field
+from typing import Any
+
+_question_only = ContextVar('native_question_only', default=False)
+_budget: ContextVar[Any] = ContextVar('native_question_budget', default=None)
+QUESTION_SECONDS = 45.0
+QUESTION_CALLS = 2
+
+
+@dataclass
+class QuestionBudget:
+    deadline: float = field(default_factory=lambda: time.monotonic() + QUESTION_SECONDS)
+    calls: int = 0
+    lock: Any = field(default_factory=threading.Lock)
+
+
+class QuestionBudgetExceeded(InterruptedError):
+    pass
+
+
+def question_active():
+    return _question_only.get()
+
+
+def take_question_call():
+    budget = _budget.get()
+    if not _question_only.get():
+        return True
+    if budget is None:
+        return False
+    with budget.lock:
+        if time.monotonic() >= budget.deadline or budget.calls >= QUESTION_CALLS:
+            return False
+        budget.calls += 1
+        return True
+
+
+def question_remaining():
+    budget = _budget.get()
+    return max(0.0, budget.deadline - time.monotonic()) if budget is not None else 0.0
+
+
+@contextmanager
+def question_agent_scope(agent):
+    if not question_active():
+        yield
+        return
+    from agent.side_question_request import _agent_provider_refusal
+    if _agent_provider_refusal(agent):
+        raise RuntimeError('question capability cannot execute a provider-owned agent')
+    names = ('tools', 'valid_tool_names', 'max_iterations', 'max_tokens', '_disable_streaming')
+    previous = {name: getattr(agent, name) for name in names}
+    agent.tools, agent.valid_tool_names = [], set()
+    agent.max_iterations = min(agent.max_iterations, QUESTION_CALLS)
+    agent.max_tokens = min(agent.max_tokens or 2048, 2048)
+    # Streaming transports have private reconnect loops. A bounded question
+    # uses a single cancellable non-stream attempt, not those retry ladders.
+    agent._disable_streaming = True
+    timer = threading.Timer(question_remaining(),
+        lambda: agent.interrupt(None, tool_reason='question absolute deadline exceeded'))
+    timer.daemon = True
+    timer.start()
+    try:
+        yield
+    finally:
+        timer.cancel()
+        timer.join()
+        for name, value in previous.items():
+            setattr(agent, name, value)
+
+
+def branch_intent(ledger, session_id):
+    """Read the creation decision, never a later follow-up's intent."""
+    ledger = Path(ledger)
+    if not ledger.exists():
+        return None
+    with sqlite3.connect(ledger) as db:
+        row = db.execute('''SELECT d.intent FROM tasks t JOIN decisions d
+            ON d.task=t.id AND d.room=t.room AND d.sender=t.sender AND d.message=t.message
+            WHERE t.session=?''', (session_id,)).fetchone()
+    return row[0] if row else None
+
+
+@contextmanager
+def question_execution_scope(ledger, session_id):
+    # Nested execution cannot shed an inherited restriction. Context copies into
+    # native worker/tool executor threads; token reset restores the caller exactly.
+    token = _question_only.set(_question_only.get() or branch_intent(ledger, session_id) == 'question')
+    budget_token = _budget.set((_budget.get() or QuestionBudget()) if _question_only.get() else None)
+    try:
+        yield
+    finally:
+        _budget.reset(budget_token)
+        _question_only.reset(token)
+
+
+def question_tool_denial(tool_name):
+    """Fail closed for every tool, including new/unknown tools and bridge wrappers.
+
+    Status/general questions use the fixed collaboration snapshot already copied
+    into native history. Broader research/work needs an ordinary work admission;
+    there is deliberately no terminal, delegation, connector or code escape hatch.
+    """
+    if _question_only.get():
+        return ('question_lane_read_only: this task can answer only from its fixed '
+                'context snapshot; tools are disabled. Request new work separately.')
+    return None
