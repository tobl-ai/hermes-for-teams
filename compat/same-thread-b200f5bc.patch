new file mode 100644
index 00000000..27394075
--- /dev/null
+++ b/tools/environments/local_supervision.py
@@ -0,0 +1,142 @@
+"""Separate logical command result from local physical descendant completion.
+
+Only callers with a native lease use this path. No result JSON can attest P;
+the private supervisor pipe is closed before command exec. A missing/malformed
+receipt never invokes settlement. Owner/supervisor death leaves the lease held.
+"""
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import threading
+
+
+class PhysicalExecutionUnknown(RuntimeError):
+    """A started physical execution may not be replayed or fallen back."""
+
+
+class SupervisedProcess:
+    def __init__(self, proc, receipt, on_physical_done):
+        self._supervisor = proc
+        self.pid = proc.pid
+        self.stdout, self.stdin, self.stderr = proc.stdout, proc.stdin, proc.stderr
+        self.returncode = None
+        self._root_done = threading.Event()
+        self._physical_done = threading.Event()
+        self._ready = threading.Event()
+        self._ready_received = False
+        self._reader = threading.Thread(target=self._read_receipt,
+                                        args=(receipt, on_physical_done), daemon=True)
+        self._reader.start()
+
+    def _read_receipt(self, receipt, callback):
+        saw_root = False
+        try:
+            with os.fdopen(receipt, 'rb') as stream:
+                line = stream.readline(64)
+                if line == b'S\n':
+                    self._ready_received = True
+                    self._ready.set()
+                    line = stream.readline(64)
+                if line.startswith(b'R ') and line.endswith(b'\n'):
+                    self.returncode = int(line[2:])
+                    saw_root = True
+                    self._root_done.set()
+                physical = stream.readline(64) if saw_root else b''
+                # EOF alone, root exit and even wrapper exit 0 are NOT certificates.
+                if saw_root and physical == b'P\n':
+                    callback()
+                    self._physical_done.set()
+        finally:
+            rc = self._supervisor.wait()
+            if not saw_root:
+                self.returncode = rc
+            self._ready.set()
+            self._root_done.set()
+
+    def poll(self):
+        return self.returncode if self._root_done.is_set() else None
+
+    def wait(self, timeout=None):
+        if not self._root_done.wait(timeout):
+            raise subprocess.TimeoutExpired(self._supervisor.args, timeout)
+        return self.returncode
+
+    def kill(self):
+        # Let the subreaper drain/reap all descendants; SIGKILLing the supervisor
+        # cannot produce a completion certificate. Force-exit may still do that.
+        self._supervisor.send_signal(signal.SIGTERM)
+
+    terminate = kill
+
+    def send_signal(self, signum):
+        self._supervisor.send_signal(signum)
+
+
+def spawn_supervised(argv, *, on_physical_done, **kwargs):
+    if sys.platform != 'linux':
+        raise RuntimeError('Local genealogy receipt requires Linux subreaper support')
+    read_fd, write_fd = os.pipe()
+    worker = str(Path(__file__).with_name('local_supervisor_worker.py'))
+    try:
+        proc = subprocess.Popen([sys.executable, '-I', worker, str(write_fd), *argv],
+                                pass_fds=(write_fd,), **kwargs)
+    except BaseException:
+        os.close(read_fd)
+        raise
+    finally:
+        os.close(write_fd)
+    supervised = SupervisedProcess(proc, read_fd, on_physical_done)
+    if not supervised._ready.wait(10) or not supervised._ready_received:
+        supervised.kill()
+        raise PhysicalExecutionUnknown('Local physical supervisor did not acknowledge readiness; do not replay')
+    return supervised
+
+
+def spawn_supervised_pty(cls, argv, *, on_physical_done, **kwargs):
+    """PTY registry owns waitpid; the separate receipt observer never reaps it.
+
+    Background PTY completion remains running until the whole physical operation
+    ends; the worker exits with the logical root status after draining children.
+    """
+    if sys.platform != 'linux':
+        raise PhysicalExecutionUnknown('Local PTY physical receipts require Linux')
+    read_fd, write_fd = os.pipe()
+    ready = threading.Event()
+    done = threading.Event()
+    valid_ready = []
+    worker = str(Path(__file__).with_name('local_supervisor_worker.py'))
+    try:
+        proc = cls.spawn([sys.executable, '-I', worker, str(write_fd), *argv],
+                         pass_fds=(write_fd,),
+                         preexec_fn=lambda: os.set_inheritable(write_fd, True), **kwargs)
+    except BaseException as exc:
+        os.close(read_fd)
+        raise PhysicalExecutionUnknown('PTY supervisor launch uncertain; do not replay') from exc
+    finally:
+        os.close(write_fd)
+
+    def observe():
+        try:
+            with os.fdopen(read_fd, 'rb') as stream:
+                if stream.readline(64) != b'S\n':
+                    return
+                valid_ready.append(True)
+                ready.set()
+                root = stream.readline(64)
+                if not root.startswith(b'R ') or not root.endswith(b'\n'):
+                    return
+                int(root[2:])
+                if stream.readline(64) == b'P\n':
+                    on_physical_done()
+                    done.set()
+        finally:
+            ready.set()
+
+    threading.Thread(target=observe, daemon=True, name='native-pty-receipt').start()
+    proc._hermes_physical_done = done
+    if not ready.wait(10) or not valid_ready:
+        proc.kill(signal.SIGTERM)
+        raise PhysicalExecutionUnknown('PTY supervisor readiness uncertain; do not replay')
+    return proc
diff --git a/tools/environments/local_supervisor_worker.py b/tools/environments/local_supervisor_worker.py
new file mode 100644
index 00000000..3cfdfc1f
--- /dev/null
+++ b/tools/environments/local_supervisor_worker.py
@@ -0,0 +1,70 @@
+"""Private Linux per-operation subreaper. Invoked as a script, stdlib only.
+
+R reports only logical root exit; P is emitted exclusively after waitpid returns
+ECHILD. setsid/double-fork/CLONE_UNTRACED do not bypass kernel reparenting. This
+proves local genealogy quiescence, NOT external daemon/API/remote completion and
+is not a security sandbox against deliberately hostile same-UID programs.
+"""
+import ctypes
+import errno
+import os
+import signal
+import subprocess
+import sys
+
+
+def main():
+    fd = int(sys.argv[1])
+    libc = ctypes.CDLL(None, use_errno=True)
+    if libc.prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
+        raise OSError(ctypes.get_errno(), 'PR_SET_CHILD_SUBREAPER failed')
+    cancelled = False
+
+    def kill_children():
+        # Only our immediate children; every orphan is adopted here. Repeated
+        # waitpid/kill drains generations without racing a process-tree snapshot.
+        children = f'/proc/self/task/{os.getpid()}/children'
+        with open(children) as stream:
+            pids = stream.read().split()
+        for pid in pids:
+            try:
+                os.kill(int(pid), signal.SIGKILL)
+            except ProcessLookupError:
+                continue
+
+    def cancel(signum, frame):
+        nonlocal cancelled
+        cancelled = True
+        kill_children()
+
+    signal.signal(signal.SIGTERM, cancel)
+    signal.signal(signal.SIGINT, cancel)
+    os.write(fd, b'S\n')  # ready: subreaper and cancellation handler are installed
+    if cancelled:
+        os.write(fd, b'R 130\nP\n')  # no command was started; no children exist
+        return 130
+    root = subprocess.Popen(sys.argv[2:], close_fds=True)
+    # Neither an unrelated helper nor a descendant inherits the receipt channel.
+    root_code = None
+    while True:
+        if cancelled:
+            kill_children()
+        try:
+            pid, status = os.waitpid(-1, 0)
+        except ChildProcessError:
+            break
+        except InterruptedError:
+            continue
+        if pid == root.pid:
+            root_code = os.waitstatus_to_exitcode(status)
+            root.returncode = root_code
+            os.write(fd, f'R {root_code}\n'.encode('ascii'))
+    if root_code is None:
+        return 125
+    os.write(fd, b'P\n')
+    os.close(fd)
+    return root_code if root_code >= 0 else 128 - root_code
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/tools/environments/remote_supervision.py b/tools/environments/remote_supervision.py
new file mode 100644
index 00000000..8e52f2ed
--- /dev/null
+++ b/tools/environments/remote_supervision.py
@@ -0,0 +1,202 @@
+"""Linux remote command genealogy receipts via the native backend transport.
+
+The HMAC challenge belongs to one host-journalled operation. A root exit, transport
+success, tool-handler JSON or missing/truncated receipt cannot settle its lease.
+This covers processes/files in that backend, not external API/daemon effects.
+"""
+import hashlib
+import hmac
+import json
+import secrets
+import shlex
+
+_WORKER = r'''
+import ctypes, hashlib, hmac, json, os, signal, subprocess, sys
+request = json.loads(sys.argv[1])
+if sys.platform != 'linux' or ctypes.CDLL(None, use_errno=True).prctl(36,1,0,0,0) != 0:
+    raise RuntimeError('Remote physical supervisor requires Linux subreaper')
+cancelled = False
+def kill_children():
+    for task in os.listdir('/proc/self/task'):
+        try:
+            children = open('/proc/self/task/'+task+'/children').read().split()
+        except FileNotFoundError:
+            continue
+        for pid in children:
+            try: os.kill(int(pid), signal.SIGKILL)
+            except ProcessLookupError: pass
+def cancel(sig, frame):
+    global cancelled
+    cancelled = True
+    kill_children()
+signal.signal(signal.SIGTERM, cancel)
+signal.signal(signal.SIGINT, cancel)
+def emit(payload):
+    body = json.dumps(dict(payload, operation=request['operation'], nonce=request['nonce']),sort_keys=True)
+    mac = hmac.new(bytes.fromhex(request['key']),body.encode(),hashlib.sha256).hexdigest()
+    print('\nHERMES-PHYSICAL-RECEIPT '+json.dumps({'body':body,'mac':mac}),flush=True)
+start = open('/proc/self/stat').read().rsplit(')',1)[1].split()[19]
+emit({'ready':True,'pid':os.getpid(),'start':start})
+child_env = os.environ.copy()
+if request.get('clean'):
+    child_env.pop('BASH_ENV', None)
+    child_env.pop('ENV', None)
+args = ['bash', '--noprofile', '--norc', '-c'] if request.get('clean') else ['bash', '-lc' if request.get('login') else '-c']
+root = subprocess.Popen([*args,request['command']], close_fds=True, env=child_env)
+code = None
+while True:
+    if cancelled: kill_children()
+    try: pid, status = os.waitpid(-1,0)
+    except ChildProcessError: break
+    except InterruptedError: continue
+    if pid == root.pid:
+        code = os.waitstatus_to_exitcode(status)
+        root.returncode = code
+if code is None: raise RuntimeError('No root termination evidence')
+emit({'physical_done':True,'returncode':code})
+sys.exit(code if code >= 0 else 128-code)
+'''
+
+
+class RemoteReceipt:
+    def __init__(self, witness, command, *, login=False, clean=False):
+        self.witness = witness
+        self.operation = witness._operation() if witness is not None else secrets.token_hex(16)
+        self.key = secrets.token_bytes(32)
+        self.nonce = secrets.token_hex(32)
+        self.ready = None
+        self.done = False
+        self.exit_code = None
+        request = {'command': command, 'operation': self.operation, 'key': self.key.hex(), 'nonce': self.nonce,
+                   'login': login, 'clean': clean}
+        self.argv = ['python3', '-I', '-c', _WORKER, json.dumps(request)]
+        self.command = 'python3 -c ' + shlex.quote(_WORKER) + ' ' + shlex.quote(json.dumps(request))
+        if witness is not None:
+            witness.local_handler = True
+
+    def observe(self, result):
+        output = result.get('output') or ''
+        cleaned = []
+        for line in output.splitlines(keepends=True):
+            if not line.startswith('HERMES-PHYSICAL-RECEIPT '):
+                cleaned.append(line)
+                continue
+            try:
+                envelope = json.loads(line.split(' ',1)[1])
+                body = envelope['body']
+                mac = hmac.new(self.key,body.encode(),hashlib.sha256).hexdigest()
+                if not hmac.compare_digest(envelope['mac'],mac):
+                    cleaned.append(line)
+                    continue
+                receipt = json.loads(body)
+                if receipt.get('operation') != self.operation or receipt.get('nonce') != self.nonce:
+                    cleaned.append(line)
+                    continue
+            except (ValueError, KeyError, TypeError):
+                cleaned.append(line)
+                continue
+            if receipt.get('ready') is True:
+                self.ready = (str(receipt['pid']), receipt['start'])
+            elif receipt.get('physical_done') is True:
+                if self.witness is not None:
+                    self.witness.settle(self.operation)
+                self.exit_code = receipt.get('returncode')
+                self.done = True
+        result['output'] = ''.join(cleaned)
+        return result
+
+    def cancel(self, env):
+        if self.done:
+            return
+        if self.ready is None:
+            raise RuntimeError('Remote supervisor identity unknown; lease retained')
+        from types import SimpleNamespace
+        from tools.remote_kernel_resource import control, destroy
+        pid, start = self.ready
+        kernel = SimpleNamespace(pid=pid, native_start=start, suspended_tree=[],
+                                 sh=lambda command, timeout=15: native_control(env, command, timeout=timeout).get('output',''))
+        kernel.suspended_tree = control(kernel, 'freeze')['tree']
+        destroy(kernel)
+        self.witness.settle(self.operation)
+        self.done = True
+
+
+def observe_background(receipt, env, log_path):
+    import threading
+    from agent.memory_provider import spawn_context_thread
+    from tools.process_resource_contract import _current_process
+    def observe():
+        token = _current_process.set(None)
+        try:
+            while not receipt.done:
+                result = native_control(env, 'tail -c 8192 ' + shlex.quote(log_path) + ' 2>/dev/null', timeout=10)
+                receipt.observe(result)
+                if not receipt.done:
+                    threading.Event().wait(.1 if receipt.ready is None else 1)
+        except Exception:
+            # A lost transport cannot settle physical work or trigger replay.
+            return
+        finally:
+            _current_process.reset(token)
+    spawn_context_thread(target=observe, name='native-remote-receipt', daemon=True).start()
+
+
+def prepare_remote(env, command, *, login=False):
+    from tools.process_resource_contract import _current_process
+    from tools.environments.local import LocalEnvironment
+    witness = _current_process.get()
+    if witness is None:
+        from tools.kernel_resource_contract import _current_kernel
+        kernel = _current_kernel.get()
+        witness = kernel.physical if kernel is not None else None
+    if witness is None or isinstance(env, LocalEnvironment):
+        return command, None
+    receipt = RemoteReceipt(witness, command, login=login)
+    return receipt.command, receipt
+
+
+def native_control(env, command, *, timeout=15, stdin_data=None):
+    """Direct trusted entrypoint for control I/O; shell startup never runs first."""
+    receipt = RemoteReceipt(None, command, clean=True)
+    proc = env._run_native_argv(receipt.argv, timeout=timeout, stdin_data=stdin_data)
+    result = receipt.observe(env._wait_for_process(proc, timeout=timeout))
+    if not receipt.done:
+        raise RuntimeError('Native control transport completion unknown')
+    return result
+
+
+def background_command(session, command, env=None, cwd=None):
+    from tools.process_resource_contract import _current_process
+    witness = _current_process.get()
+    if witness is None:
+        return command
+    if env is not None:
+        command = env._wrap_command(command, cwd or env.cwd)
+    receipt = session._native_remote_receipt = RemoteReceipt(witness, command, login=True)
+    session._native_resource_lease = witness.lease
+    return receipt.command
+
+
+def launch_background(session, env, log_path, launch, *, pid_path=None):
+    receipt = getattr(session, '_native_remote_receipt', None)
+    if receipt is None:
+        return launch()
+    # This bootstrap is direct Python, never a shell which could create siblings
+    # before the request supervisor exists. All user shell startup is below it.
+    source = '''import json,os,subprocess,sys
+r=json.loads(sys.argv[1]); os.umask(0o077)
+with open(r['log'],'w') as log:
+ p=subprocess.Popen(r['argv'],stdin=subprocess.DEVNULL,stdout=log,stderr=subprocess.STDOUT,start_new_session=True,close_fds=True)
+with open(r['pid'],'w') as f: f.write(str(p.pid))
+print(p.pid,flush=True)
+'''
+    request = {'argv': receipt.argv, 'log': log_path, 'pid': pid_path}
+    proc = env._run_native_argv(['python3','-I','-c',source,json.dumps(request)],timeout=10)
+    result = env._wait_for_process(proc,timeout=10)
+    observe_background(receipt, env, log_path)
+    return result
+
+
+def control_view(env):
+    from types import SimpleNamespace
