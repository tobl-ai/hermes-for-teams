diff --git a/tools/kernel_resource_contract.py b/tools/kernel_resource_contract.py
new file mode 100644
index 00000000..292ebd34
--- /dev/null
+++ b/tools/kernel_resource_contract.py
@@ -0,0 +1,189 @@
+"""Linux persistent-kernel local execution isolation, not an exec-return receipt.
+
+Between leased requests the whole subreaper-owned genealogy is SIGSTOPped. State,
+threads and asyncio loops remain intact, but cannot run until another global lease
+is held. This is not hostile-code sandboxing, external API settlement, or a claim
+that detached application work completed. Missing OS evidence retains the lease.
+"""
+from contextvars import ContextVar
+from pathlib import Path
+import os
+import signal
+import select
+import sys
+import threading
+import time
+from typing import Optional
+
+
+class KernelIsolation:
+    def __init__(self, guard, lease):
+        self.guard, self.lease = guard, lease
+        self.isolated = False
+        self.uncertain = False
+        from tools.process_resource_contract import ProcessCompletion
+        self.physical = ProcessCompletion(guard, lease)
+        self.physical.local_handler = True
+        self.kernel_operation = self.physical._operation()
+
+
+_current_kernel: ContextVar[Optional[KernelIsolation]] = ContextVar('native_kernel_isolation', default=None)
+
+
+def reserved_kernel(guard, args, next_call):
+    from gateway.task_resources import ResourceBusy
+    lease = guard.acquire(('*',))
+    if lease is None:
+        raise ResourceBusy('Physical or unknown write reservation is still held')
+    witness = KernelIsolation(guard, lease)
+    token = _current_kernel.set(witness)
+    try:
+        return next_call(args)
+    finally:
+        _current_kernel.reset(token)
+        if witness.isolated and not witness.uncertain:
+            witness.physical.settle(witness.kernel_operation)
+        witness.physical.seal(failed=not witness.isolated or witness.uncertain)
+
+
+def owned_dispatch(witness, guard, tool, args, task_id, next_call):
+    """Only an authenticated active cell may extend its existing global lease.
+
+    Native bounded file bodies have their own witness. Shell/remote work adds
+    physical operations to the parent certificate; suspension alone cannot settle
+    those. Unknown handlers never gain a generic nested-execution bypass.
+    """
+    from gateway.task_resources import ResourceBusy
+    from tools.file_resource_contract import prepare, _current
+    from tools.process_resource_contract import _current_process
+    if witness.guard.path != guard.path or tool not in {'write_file', 'patch', 'terminal'}:
+        raise ResourceBusy('Nested kernel operation cannot expand its native authority')
+    file_witness = prepare(tool, args, task_id) if tool != 'terminal' else None
+    if file_witness is not None:
+        token = _current.set(file_witness)
+        try:
+            return next_call(args)
+        finally:
+            _current.reset(token)
+            if not file_witness.complete:
+                witness.uncertain = True
+    before = witness.physical.operations
+    token = _current_process.set(witness.physical)
+    try:
+        return next_call(args)
+    finally:
+        _current_process.reset(token)
+        if witness.physical.operations == before:
+            witness.uncertain = True
+
+
+def _tasks(pid):
+    return list(Path(f'/proc/{pid}/task').iterdir())
+
+
+def _state(task):
+    # comm can contain parentheses and spaces; fields start after its LAST ')'.
+    return (task / 'stat').read_text().rsplit(')', 1)[1].split()[0]
+
+
+def _children(pid):
+    result = set()
+    for task in _tasks(pid):
+        result.update(int(p) for p in (task / 'children').read_text().split())
+    return result
+
+
+def freeze(kernel, timeout=5):
+    """Stop parents before enumerating children; adoption closes double-fork races.
+
+    The runner installs PR_SET_CHILD_SUBREAPER before user code. Once all parent
+    threads are stopped they cannot create children. Exiting children are adopted
+    by that stopped root, so a repeated traversal reaches a closed, stopped tree.
+    No elapsed-time or handler-supplied flag is used as proof.
+    """
+    if sys.platform != 'linux' or not kernel.native_isolation:
+        return False
+    root = kernel.proc.pid
+    deadline = time.monotonic() + timeout
+    pending = [root]
+    stopped = set()
+    try:
+        while pending:
+            pid = pending.pop()
+            if pid in stopped:
+                continue
+            try:
+                handle = kernel.frozen_handles.get(pid)
+                if handle is None:
+                    handle = kernel.frozen_handles[pid] = os.pidfd_open(pid)
+                signal.pidfd_send_signal(handle, signal.SIGSTOP)
+                while True:
+                    tasks = _tasks(pid)
+                    if tasks and all(_state(task) in {'T', 't', 'Z', 'X'} for task in tasks):
+                        break
+                    if time.monotonic() >= deadline:
+                        return False
+                    threading.Event().wait(.005)
+                stopped.add(pid)
+                pending.extend(_children(pid))
+            except FileNotFoundError:
+                if pid == root:
+                    return False
+            except ProcessLookupError:
+                if pid == root:
+                    return False
+            if not pending:
+                # Re-scan ancestors for children adopted during the traversal.
+                for parent in list(stopped):
+                    try:
+                        pending.extend(_children(parent) - stopped)
+                    except FileNotFoundError:
+                        if parent == root:
+                            return False
+            if time.monotonic() >= deadline:
+                return False
+        if kernel.proc.poll() is not None:
+            return False
+        kernel.frozen_pids = stopped
+        return True
+    except (OSError, ValueError):
+        return False
+
+
+def thaw(kernel):
+    """Called only while the request owns the global reservation and kernel lock."""
+    # Resume descendants first; the stopped root cannot spawn a new generation.
+    for pid in sorted(kernel.frozen_pids - {kernel.proc.pid}):
+        try:
+            signal.pidfd_send_signal(kernel.frozen_handles[pid], signal.SIGCONT)
+        except ProcessLookupError:
+            continue
+    if kernel.frozen_pids:
+        signal.pidfd_send_signal(kernel.frozen_handles[kernel.proc.pid], signal.SIGCONT)
+    kernel.frozen_pids.clear()
+    for handle in kernel.frozen_handles.values():
+        os.close(handle)
+    kernel.frozen_handles.clear()
+
+
+def destroy_frozen(kernel):
+    """Never resume a frozen writer during unleased idle eviction/owner teardown."""
+    if not kernel.frozen_pids:
+        return False
+    for pid in kernel.frozen_pids:
+        try:
+            signal.pidfd_send_signal(kernel.frozen_handles[pid], signal.SIGKILL)
+        except ProcessLookupError:
+            continue
+    # pidfd readability proves the exact process exited, including adopted and
+    # setsid children. PID reuse and zombie reaping cannot substitute identities.
+    deadline = time.monotonic() + 5
+    for handle in kernel.frozen_handles.values():
+        if not select.select([handle], [], [], max(0, deadline - time.monotonic()))[0]:
+            raise RuntimeError('Frozen kernel descendant did not physically exit')
+    kernel.proc.wait(timeout=5)
+    kernel.frozen_pids.clear()
+    for handle in kernel.frozen_handles.values():
+        os.close(handle)
+    kernel.frozen_handles.clear()
+    return True
diff --git a/tools/native_diagnostic_worker.py b/tools/native_diagnostic_worker.py
new file mode 100644
index 00000000..28fe11f9
--- /dev/null
+++ b/tools/native_diagnostic_worker.py
@@ -0,0 +1,46 @@
+"""Request-owned diagnostic subprocess; never shares a live language server.
+
+The parent holds a global native resource lease until the subreaper certifies
+this worker AND every diagnostic descendant exited. JSON below is only content,
+not physical-done authority. Snapshots prevent reporting a later writer's file.
+"""
+import json
+from pathlib import Path
+import sys
+
+# Script invocation must use the exact candidate core, not an installed core.
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+
+def main():
+    request = json.load(sys.stdin)
+    path = request['path']
+    post = request.get('post')
+    if post is not None and Path(path).read_text(encoding='utf-8-sig') != post.replace('\r\n', '\n').lstrip('\ufeff'):
+        print(json.dumps({'status': 'superseded', 'text': ''}))
+        return
+    from tools.file_operations import ShellFileOperations
+    from tools.environments.local import LocalEnvironment
+    from agent.lsp import shutdown_service
+    ops = ShellFileOperations(LocalEnvironment(cwd=request['cwd']))
+    text = []
+    try:
+        syntax = ops._check_lint_delta(path, request.get('pre'), post)
+        if not syntax.success and not syntax.skipped:
+            text.append(syntax.output or syntax.message or 'Syntax diagnostic failed')
+        if syntax.success or syntax.skipped:
+            svc = ops._lsp_service()
+            if svc is not None and svc.enabled_for(path):
+                future = svc.start_edit_check(path, pre_text=request.get('pre'), post_text=post, owner='', carry=())
+                if future is not None:
+                    result = future.result(timeout=30)
+                    if not result.superseded and result.diagnostics is not None:
+                        from tools.file_operations_lint import _format_lsp_block
+                        text.append(_format_lsp_block(path, result.diagnostics, 'LSP diagnostics introduced by this edit:\n'))
+    finally:
+        shutdown_service()  # only this disposable worker's servers
+    print(json.dumps({'status': 'completed', 'text': '\n'.join(item for item in text if item)}))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/native_diagnostics.py b/tools/native_diagnostics.py
new file mode 100644
index 00000000..4cead8e9
--- /dev/null
+++ b/tools/native_diagnostics.py
@@ -0,0 +1,84 @@
+"""Durable, non-replayed native diagnostics queued after bounded file writes.
+
+A new global lease is acquired before any external linter/LSP spawn. Request
+subreaper receipts, not diagnostic JSON, release it. Completion is published to
+the originating agent's existing deferred diagnostic channel and a durable row.
+"""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import threading
+import uuid
+
+
+def queue_diagnostics(ops, path, pre, post):
+    from tools.file_resource_contract import _current
+    from gateway.task_resources import ResourceGuard, shared_guard_path
+    from agent.lsp import deferred
+    from agent.memory_provider import spawn_context_thread
+    from hermes_constants import get_hermes_home
+    witness = _current.get()
+    if witness is None:
+        raise RuntimeError('Diagnostic scheduling requires a native file witness')
+    guard = ResourceGuard(shared_guard_path())
+    request_id = uuid.uuid4().hex
+    owner = deferred.current_owner()
+    pending = deferred.track_pending(owner) if owner else None
+    request = {'path': str(ops._native_path(path)), 'pre': pre, 'post': post,
+               'cwd': str(getattr(ops.env, 'cwd', None) or ops.cwd)}
+    with guard.connect() as db:
+        db.execute('''CREATE TABLE IF NOT EXISTS diagnostics
+                      (id TEXT PRIMARY KEY, owner TEXT, state TEXT NOT NULL, output TEXT)''')
+        db.execute('INSERT INTO diagnostics VALUES (?,?,?,NULL)', (request_id, owner, 'queued'))
+    home = str(get_hermes_home())
+    def run():
+        lease = None
+        try:
+            while lease is None:
+                lease = guard.acquire(('*',))
+                if lease is None:
+                    threading.Event().wait(.025)
+            with guard.connect() as db:
+                db.execute('UPDATE diagnostics SET state=? WHERE id=?', ('started', request_id))
+            output = _run_worker(guard, lease, home, request)
+            with guard.connect() as db:
+                db.execute('UPDATE diagnostics SET state=?,output=? WHERE id=?',
+                           ('completed', output, request_id))
+            if owner and output:
+                deferred.post(owner, request['path'], output, post)
+        except Exception as exc:
+            with guard.connect() as db:
+                db.execute('UPDATE diagnostics SET state=?,output=? WHERE id=?',
+                           ('unknown', f'{type(exc).__name__}: {exc}', request_id))
+        finally:
+            if pending is not None:
+                deferred.settled(owner, pending)
+    # A copied profile/deferred owner scope, not a bare launch-profile thread.
+    spawn_context_thread(target=run, name='native-diagnostic-' + request_id[:8], daemon=True).start()
+    return 'Native diagnostics pending; request ' + request_id + ' (linter/LSP descendants are lease-tracked).'
+
+
+def _run_worker(guard, lease, home, request):
+    from tools.process_resource_contract import ProcessCompletion
+    from tools.environments.local import served_profile_child_env
+    worker = Path(__file__).with_name('native_diagnostic_worker.py')
+    witness = ProcessCompletion(guard, lease)
+    witness.local_handler = True
+    env = served_profile_child_env(target_home=home, inherit_credentials=False)
+    proc = witness.spawn([sys.executable, str(worker)], cwd=request['cwd'], env=env,
+                         stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    try:
+        output, _ = proc._supervisor.communicate(json.dumps(request).encode(), timeout=45)
+    except subprocess.TimeoutExpired:
+        proc.kill()
+        witness.seal()
+        raise RuntimeError('Native diagnostics timed out; physical receipt still owns settlement')
+    witness.seal()
+    if not proc._physical_done.wait(5):
+        raise RuntimeError('Diagnostic process returned without physical-done receipt')
+    if proc.returncode != 0:
+        raise RuntimeError('Native diagnostic worker failed: ' + output.decode('utf-8', 'replace')[-2000:])
+    # Logs can precede the result; the final JSON carries content only.
+    result = json.loads(output.decode('utf-8', 'replace').splitlines()[-1])
+    return str(result.get('text') or '')
diff --git a/tools/native_remote_kernel.py b/tools/native_remote_kernel.py
