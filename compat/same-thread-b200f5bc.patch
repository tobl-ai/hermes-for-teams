diff --git a/tools/file_resource_contract.py b/tools/file_resource_contract.py
new file mode 100644
index 00000000..74739936
--- /dev/null
+++ b/tools/file_resource_contract.py
@@ -0,0 +1,94 @@
+"""Backend-owned witness for in-process file operations, never model-supplied.
+
+The witness is consumed by native reservations. Shell/remote fallback poisons it;
+a JSON result or a cancelled waiter cannot certify physical completion.
+"""
+from contextvars import ContextVar
+from dataclasses import dataclass, field
+from copy import deepcopy
+from functools import wraps
+
+_current: ContextVar[FileCompletion | None] = ContextVar('file_backend_completion', default=None)
+
+
+@dataclass
+class FileCompletion:
+    tool: str
+    resources: tuple
+    args: dict = field(default_factory=dict)
+    task_id: str = 'default'
+    backend: object = None
+    returned: bool = False
+    uncertain: bool = False
+
+    @property
+    def complete(self):
+        return self.returned and not self.uncertain
+
+
+def prepare(tool, args, task_id):
+    if tool not in {'write_file', 'patch'}:
+        return None
+    from tools.file_tools import _get_file_ops, _collect_v4a_header_paths
+    from tools.file_tools_paths import _resolve_path_for_task
+    from gateway.task_resources import ResourceGuard
+    ops = _get_file_ops(task_id or 'default')
+    if not ops._native_read_enabled():
+        return None
+    paths = [args.get('path')]
+    if tool == 'patch' and args.get('mode') == 'patch':
+        collected = _collect_v4a_header_paths(args.get('patch') or '')
+        if isinstance(collected, str):
+            return None
+        # Entry mutations (delete/move) can alter another operation's namespace.
+        if collected[2]:
+            return None
+        paths = collected[0]
+    if not paths or any(not isinstance(path, str) or not path for path in paths):
+        return None
+    resources = set()
+    for path in paths:
+        resolved = str(_resolve_path_for_task(path, task_id or 'default'))
+        resources.update(ResourceGuard.resources('write_file', {'path': resolved}))
+    return FileCompletion(tool, tuple(sorted(resources)), deepcopy(args), task_id or 'default', ops)
+
+
+def witnessed(tool):
+    """Only the real native handler can attest that its synchronous body returned."""
+    def decorate(fn):
+        @wraps(fn)
+        def call(*args, **kwargs):
+            witness = _current.get()
+            if witness is not None:
+                from gateway.task_resources import ResourceBusy
+                actual = prepare(tool, args[0], kwargs.get('task_id') or 'default')
+                if (actual is None or witness.tool != tool or actual.args != witness.args
+                        or actual.task_id != witness.task_id or actual.backend is not witness.backend
+                        or actual.resources != witness.resources):
+                    raise ResourceBusy('Backend execution plan changed before physical I/O')
+            result = fn(*args, **kwargs)
+            if witness is not None and witness.tool == tool:
+                witness.returned = True
+            return result
+        return call
+    return decorate
+
+
+def mark_uncertain():
+    witness = _current.get()
+    if witness is not None:
+        # A path-bounded lease cannot safely expand once disjoint writers run.
+        # Refuse BEFORE a shell/remote operation, not after an uncertain timeout.
+        from gateway.task_resources import ResourceBusy
+        raise ResourceBusy('Backend shell fallback requires a global physical reservation')
+
+def validate_native_target(backend, path):
+    witness = _current.get()
+    if witness is None:
+        return
+    from gateway.task_resources import ResourceBusy, ResourceGuard
+    keys = ResourceGuard.resources('write_file', {'path': backend._native_path(path)})
+    path_keys = {key for key in keys if key.startswith('path:')}
+    if backend is not witness.backend or not path_keys.issubset(witness.resources):
+        witness.uncertain = True
+        raise ResourceBusy('Native backend target differs from reserved execution plan')
