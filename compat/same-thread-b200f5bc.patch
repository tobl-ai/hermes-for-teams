diff --git a/tools/process_resource_contract.py b/tools/process_resource_contract.py
new file mode 100644
index 00000000..e7517a64
--- /dev/null
+++ b/tools/process_resource_contract.py
@@ -0,0 +1,106 @@
+"""Backend-owned local process receipts and durable native lease settlement.
+
+Each operation is journalled BEFORE spawn. Logical exit, timeout, registry result
+and checkpoint rows never settle it. Only the subreaper ECHILD pipe receipt does.
+A parent or supervisor crash retains the rows, without replay/age-based expiry.
+External side effects still require destination-owned receipts/idempotency.
+"""
+from contextvars import ContextVar
+import json
+import threading
+import uuid
+from typing import Any
+
+_current_process: ContextVar[Any] = ContextVar('native_process_completion', default=None)
+
+
+class ProcessCompletion:
+    def __init__(self, guard, lease):
+        self.guard, self.lease = guard, lease
+        self.lock = threading.RLock()
+        self.sealed = False
+        self.failed = False
+        self.operations = 0
+        self.local_handler = False
+        with guard.connect() as db:
+            db.execute('''CREATE TABLE IF NOT EXISTS physical_operations
+                (id TEXT PRIMARY KEY, lease TEXT NOT NULL, state TEXT NOT NULL)''')
+
+    def _operation(self):
+        with self.lock:
+            if self.sealed:
+                raise RuntimeError('Cannot extend a sealed physical execution')
+            operation = uuid.uuid4().hex
+            with self.guard.connect() as db:
+                db.execute('INSERT INTO physical_operations VALUES (?,?,?)',
+                           (operation, self.lease, 'started'))
+            self.operations += 1
+        return operation
+
+    def spawn(self, argv, **kwargs):
+        from tools.environments.local_supervision import spawn_supervised
+        operation = self._operation()
+        # Failure here is deliberately uncertain; never retry the command.
+        return spawn_supervised(argv, on_physical_done=lambda: self.settle(operation), **kwargs)
+
+    def spawn_pty(self, cls, argv, **kwargs):
+        from tools.environments.local_supervision import spawn_supervised_pty
+        operation = self._operation()
+        return spawn_supervised_pty(cls, argv, on_physical_done=lambda: self.settle(operation), **kwargs)
+
+    def settle(self, operation):
+        with self.lock, self.guard.connect() as db:
+            db.execute('UPDATE physical_operations SET state=? WHERE id=? AND lease=?',
+                       ('physical_done', operation, self.lease))
+        self._release_if_complete()
+
+    def seal(self, *, failed=False):
+        with self.lock:
+            self.failed = failed
+            self.sealed = True
+        self._release_if_complete()
+
+    def _release_if_complete(self):
+        with self.lock, self.guard.connect() as db:
+            db.execute('BEGIN IMMEDIATE')
+            pending = db.execute('SELECT COUNT(*) FROM physical_operations WHERE lease=? AND state!=?',
+                                 (self.lease, 'physical_done')).fetchone()[0]
+            if self.sealed and self.operations and self.local_handler and not self.failed and not pending:
+                db.execute('DELETE FROM reservations WHERE id=?', (self.lease,))
+            elif self.sealed:
+                db.execute('UPDATE reservations SET state=? WHERE id=?', ('unknown', self.lease))
+
+
+def reserved_terminal(guard, args, next_call):
+    lease = guard.acquire(('*',))
+    if lease is None:
+        from gateway.task_resources import ResourceBusy
+        raise ResourceBusy('Physical or unknown write reservation is still held')
+    witness = ProcessCompletion(guard, lease)
+    token = _current_process.set(witness)
+    try:
+        result = next_call(args)
+    except BaseException:
+        witness.seal(failed=True)
+        raise
+    else:
+        witness.seal()
+        return result
+    finally:
+        _current_process.reset(token)
+
+
+def may_control_leased_process(args, task_id, guard):
+    # Only the exact owned job. Stdin/write/submit/handoff are effectful commands,
+    # not completion controls, and must never pass this exception.
+    if args.get('action') not in {'poll', 'log', 'wait', 'kill'} or not task_id:
+        return False
+    from tools.process_registry import process_registry
+    session = process_registry.get(str(args.get('session_id') or ''))
+    if session is None or session.owner_task_id != task_id:
+        return False
+    lease = getattr(session, '_native_resource_lease', None)
+    if not lease:
+        return False
+    with guard.connect() as db:
+        return db.execute('SELECT 1 FROM reservations WHERE id=?', (lease,)).fetchone() is not None
diff --git a/tools/remote_kernel_resource.py b/tools/remote_kernel_resource.py
new file mode 100644
index 00000000..3126d772
--- /dev/null
+++ b/tools/remote_kernel_resource.py
@@ -0,0 +1,116 @@
+"""Native remote Linux kernel control over the backend's own execute transport.
+
+The backend runs the exact stop-tree implementation; a fresh nonce/HMAC binds its
+OS observation to this request. Cell JSON and transport exit 0 are not witnesses.
+No replay on transport uncertainty. Filesystem isolation only: not a receipt for
+external API/daemon effects, and not a hostile same-UID sandbox.
+"""
+import hashlib
+import hmac
+import json
+from pathlib import Path
+import secrets
+import shlex
+
+_CONTROL_SOURCE = r'''
+import hashlib, hmac, json, os, select, signal, sys, time
+from pathlib import Path
+from types import SimpleNamespace
+
+request = json.loads(sys.argv[1])
+def identity(pid):
+    parts = Path('/proc/%d/stat' % pid).read_text().rsplit(')', 1)[1].split()
+    return parts[19]
+def valid(pid, start):
+    try:
+        return identity(pid) == start
+    except FileNotFoundError:
+        return False
+pid = int(request['pid'])
+action = request['action']
+start = request.get('start')
+if sys.platform != 'linux':
+    raise RuntimeError('Linux kernel control unavailable')
+if action == 'inspect':
+    payload = {'start': identity(pid)}
+else:
+    if not start or not valid(pid, start):
+        raise RuntimeError('Remote kernel identity lost')
+    if action == 'freeze':
+        proc = SimpleNamespace(pid=pid, poll=lambda: None if valid(pid, start) else 1)
+        kernel = SimpleNamespace(proc=proc, native_isolation=True, frozen_handles={}, frozen_pids=set())
+        if not freeze(kernel):
+            raise RuntimeError('No closed stopped remote genealogy')
+        payload = {'tree': [[p, identity(p)] for p in sorted(kernel.frozen_pids)]}
+        for fd in kernel.frozen_handles.values(): os.close(fd)
+    else:
+        tree = request['tree']
+        handles = []
+        try:
+            for child, born in tree:
+                fd = os.pidfd_open(child)
+                handles.append((child, fd))
+                if not valid(child, born):
+                    raise RuntimeError('Remote descendant identity changed')
+            for child, fd in sorted(handles, key=lambda item: item[0] == pid):
+                signal.pidfd_send_signal(fd, signal.SIGCONT if action == 'thaw' else signal.SIGKILL)
+            if action == 'destroy':
+                deadline = time.monotonic() + 5
+                for child, fd in handles:
+                    if not select.select([fd], [], [], max(0, deadline-time.monotonic()))[0]:
+                        raise RuntimeError('Remote descendant termination uncertain')
+            payload = {'settled': True}
+        finally:
+            for child, fd in handles: os.close(fd)
+body = json.dumps({'nonce': request['nonce'], 'action': action, 'pid': pid, 'result': payload}, sort_keys=True)
+mac = hmac.new(bytes.fromhex(request['key']), body.encode(), hashlib.sha256).hexdigest()
+print('HERMES-OS-RECEIPT ' + json.dumps({'body': body, 'mac': mac}), flush=True)
+'''
+
+
+def control(kernel, action):
+    from tools import kernel_resource_contract
+    source = Path(kernel_resource_contract.__file__).read_text() + '\n' + _CONTROL_SOURCE
+    key = secrets.token_bytes(32)
+    request = {'pid': int(kernel.pid), 'action': action, 'start': kernel.native_start,
+               'tree': kernel.suspended_tree, 'nonce': secrets.token_hex(32), 'key': key.hex()}
+    command = 'python3 -c ' + shlex.quote(source) + ' ' + shlex.quote(json.dumps(request))
+    output = kernel.sh(command, timeout=15)
+    for line in output.splitlines():
+        if not line.startswith('HERMES-OS-RECEIPT '):
+            continue
+        envelope = json.loads(line.split(' ', 1)[1])
+        body = envelope['body']
+        expected = hmac.new(key, body.encode(), hashlib.sha256).hexdigest()
+        if not hmac.compare_digest(envelope['mac'], expected):
+            continue
+        receipt = json.loads(body)
+        if receipt['nonce'] == request['nonce'] and receipt['action'] == action and receipt['pid'] == int(kernel.pid):
+            return receipt['result']
+    raise RuntimeError('Remote OS physical/isolation receipt missing; do not replay')
+
+
+def attach(kernel):
+    from tools.kernel_resource_contract import _current_kernel
+    witness = _current_kernel.get()
+    if witness is None:
+        if kernel.native_start:
+            raise RuntimeError('Reserved remote kernel cannot resume without native lease')
+        return None
+    if not kernel.native_start:
+        kernel.native_start = control(kernel, 'inspect')['start']
+    if kernel.suspended_tree:
+        control(kernel, 'thaw')
+        kernel.suspended_tree = []
+    return witness
+
+
+def suspend(kernel, witness):
+    kernel.suspended_tree = control(kernel, 'freeze')['tree']
+    witness.isolated = True
+
+
+def destroy(kernel):
+    control(kernel, 'destroy')
+    kernel.suspended_tree = []
+    kernel.native_destroyed = True
