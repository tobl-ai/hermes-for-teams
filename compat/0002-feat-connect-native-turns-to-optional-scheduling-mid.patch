diff --git a/gateway/turn_scheduling.py b/gateway/turn_scheduling.py
new file mode 100644
index 0000000000..7c15a45d8f
--- /dev/null
+++ b/gateway/turn_scheduling.py
@@ -0,0 +1,130 @@
+"""Optional async scheduling seam around an ALREADY claimed native turn.
+
+No event snapshots/runner handles exposed; no consumer/reinjection, no fail-open
+retry. All scheduling errors before execution fail the admission normally. Once
+native execution starts it is joined to physical completion, never replayed.
+"""
+import asyncio
+from contextvars import ContextVar
+from types import MappingProxyType
+
+_physical_events: ContextVar[list | None] = ContextVar('gateway_scheduled_physical_events', default=None)
+_physical_join_tasks = set()
+
+
+def register_physical_completion(done_event):
+    """Called at native executor submission, before an asyncio waiter can detach."""
+    events = _physical_events.get()
+    if events is not None:
+        events.append(done_event)
+
+
+def _settle_physical(future, events):
+    if all(event.is_set() for event in events):
+        if not future.done():
+            future.set_result(None)
+        return
+
+    async def wait():
+        while not all(event.is_set() for event in events):
+            await asyncio.sleep(.05)
+        if not future.done():
+            future.set_result(None)
+
+    task = asyncio.create_task(wait())
+    _physical_join_tasks.add(task)
+    task.add_done_callback(_physical_join_tasks.discard)
+
+KIND = 'gateway_turn_execution'
+
+
+async def _join(task):
+    cancelled = False
+    while True:
+        try:
+            result = await asyncio.shield(task)
+            break
+        except asyncio.CancelledError:
+            if task.done() and task.cancelled():
+                raise
+            cancelled = True
+    if cancelled:
+        raise asyncio.CancelledError
+    return result
+
+
+async def run_scheduled_turn(next_call, **metadata):
+    from agent.safe_worker_policy import safe_worker_enabled
+    if safe_worker_enabled():
+        return await next_call()
+    from hermes_cli.plugins import _delivery_manager
+    manager = _delivery_manager()
+    # Same native registration/delivery isolation boundary as execution middleware.
+    callbacks = list(manager._middleware.get(KIND, ()))
+    if not callbacks:
+        return await next_call()
+    physical_completion = asyncio.get_running_loop().create_future()
+    events = []
+    native_started = False
+    metadata = MappingProxyType({**metadata, 'physical_completion': physical_completion})
+
+    async def call_native():
+        nonlocal native_started
+        native_started = True
+        token = _physical_events.set(events)
+        try:
+            return await next_call()
+        finally:
+            _physical_events.reset(token)
+            # A native timeout may settle its coroutine before its executor thread.
+            _settle_physical(physical_completion, events)
+
+    async def call_at(index):
+        if index == len(callbacks):
+            return await call_native()
+        closed = False
+        task = None
+
+        async def once():
+            nonlocal task
+            if closed or task is not None:
+                raise RuntimeError('gateway turn continuation is single-use and admission-scoped')
+            task = asyncio.create_task(call_at(index + 1))
+            return await _join(task)
+
+        error = None
+        try:
+            await callbacks[index](next_call=once, **metadata)
+        except BaseException as exc:
+            error = exc
+        finally:
+            closed = True
+        if task is not None:
+            # Preserve the actual terminal result/error even if policy lost its
+            # acknowledgement. A plugin cannot turn success into a retry or forge
+            # a different reply. Cancellation stays cancellation after quiescence.
+            result = await _join(task)
+            if error is not None and not isinstance(error, Exception):
+                raise error
+            return result
+        if error is not None:
+            raise error
+        raise RuntimeError('gateway scheduling middleware did not execute its continuation')
+
+    try:
+        return await call_at(0)
+    finally:
+        if not native_started:
+            _settle_physical(physical_completion, events)
+
+
+def scheduling_metadata(ref, row):
+    # Coarse size only. No prompt, source identity, media paths or authority handles.
+    payload = row['payload']
+    text = payload.get('text', '')
+    if not isinstance(text, str):
+        import json
+        text = json.dumps(text, ensure_ascii=False)
+    return {'profile_id': ref.profile_id, 'session_id': ref.session_id,
+            'admission_id': row['admission_id'],
+            'input_bytes': len(text.encode('utf-8'))}
